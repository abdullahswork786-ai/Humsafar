# ==============================================================
# HUMSAFAR Consultancy — Environment Configuration Template
# ==============================================================

# MongoDB Connection String (from MongoDB Atlas)
# Example: mongodb+srv://admin:YourPassword@cluster0.xxxxx.mongodb.net/humsafar?retryWrites=true&w=majority
MONGODB_URI=

# Resend Email Configuration (Recommended)
RESEND_API_KEY=
ADMIN_EMAIL=

# Nodemailer / SMTP Fallback (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=
EMAIL_PASS=

# Vercel Blob Token (Required for local development to upload files)
BLOB_READ_WRITE_TOKEN=
